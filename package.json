{
  "name": "live-translator",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @live-translator/web --filter @live-translator/api dev",
    "build": "pnpm -r build",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:real-two-way": "pnpm --filter @live-translator/web exec playwright test --config=playwright.real.config.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.0",
    "vitest": "^3.2.0"
  }
}

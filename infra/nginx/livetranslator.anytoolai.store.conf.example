# Host-Nginx virtual host for the current public test deployment.

server {
    listen 80;
    listen [::]:80;
    server_name livetranslator.anytoolai.store;

    include /etc/nginx/conf.d/certbot;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name livetranslator.anytoolai.store;

    ssl_certificate /etc/letsencrypt/live/livetranslator.anytoolai.store/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/livetranslator.anytoolai.store/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Change to "Live Translator" to restore password protection.
    auth_basic off;
    auth_basic_user_file /etc/nginx/.htpasswd-livetranslator;

    location /api/ {
        proxy_pass http://127.0.0.1:13001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# Example host-Nginx virtual host for Live Translator.
# Reuse the server's existing TLS include/certificate convention instead of
# installing a second TLS stack or letting the application container bind 80/443.

server {
    listen 80;
    listen [::]:80;
    server_name livetranslator.agent-studio.ru;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name livetranslator.agent-studio.ru;

    # Reuse the existing server TLS template/certificate setup here.
    # Example only:
    # include /etc/nginx/snippets/trioncalls-ssl.conf;
    #
    # Do not copy guessed certificate paths into production.

    # Required for the internal prototype. This protects both the PWA and the
    # paid /api/live/session endpoint before requests reach the containers.
    auth_basic "Live Translator";
    auth_basic_user_file /etc/nginx/.htpasswd-livetranslator;

    location /api/ {
        proxy_pass http://127.0.0.1:13001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

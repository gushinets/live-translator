OPENAI_API_KEY=
WEB_ORIGIN=https://livetranslator.agent-studio.ru
API_BIND_PORT=13001
WEB_BIND_PORT=18081
VITE_ADDITIONAL_ALLOWED_HOST=

# Explicit internal-test profile. Without these variables, API/Compose use
# 5 concurrent sessions and 20 creation attempts per 600000 ms per IPv4 address / IPv6 /56.
MAX_CONCURRENT_SESSIONS=15
LIVE_SESSION_LEASE_MS=900000
LIVE_SESSION_RATE_LIMIT=60
LIVE_SESSION_RATE_WINDOW_MS=600000

# Coordinated stage-2 rollout. Remains OFF until reviewed and smoke-tested.
USAGE_LEDGER_ENABLED=false
# Stage-5 lifecycle rollout; requires USAGE_LEDGER_ENABLED=true.
BACKGROUND_SESSION_CLOSE_ENABLED=false
# pnpm dev runs outside Docker; Compose uses /data/live-translator.sqlite instead.
USAGE_DB_PATH=./.data/live-translator.sqlite
CONVERSATION_RETENTION_MS=300000
MAX_PROVIDER_SESSION_MS=900000
MAX_CONVERSATION_ELAPSED_MS=900000
SESSION_CLOSE_TIMEOUT_MS=15000
SESSION_HANDOFF_ACK_TIMEOUT_MS=30000
RESUME_CLAIM_TIMEOUT_MS=60000
CLEANUP_WORKER_CONCURRENCY=2
CLEANUP_WORKER_BATCH_SIZE=20
SERVER_SHUTDOWN_DRAIN_MS=18000
SERVER_SHUTDOWN_TIMEOUT_MS=40000
